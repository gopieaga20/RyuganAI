# Copy this file to .env and fill in your values
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/trading_app

# Angel One SmartAPI credentials (optional — omit to run on Yahoo Finance data only)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Anthropic API key — used server-side only by /api/ai/chat.
# Never exposed to the browser. Omit to run on algorithmic fallback signals only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Comma-separated list of origins allowed to call this API (CORS).
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
